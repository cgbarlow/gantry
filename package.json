{
  "name": "gantry",
  "version": "0.7.2-beta",
  "license": "MIT",
  "private": true,
  "description": "A repo-driven pipeline for staged, gated processes.",
  "type": "module",
  "bin": {
    "gantry": "./bin/gantry.js"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test $(find tests -maxdepth 1 -name '*.test.js' ! -name '*.playwright.test.js' | sort)",
    "test:unit:ci": "mkdir -p results && node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=70 --test-coverage-include='lib/**/*.js' --test-coverage-include='bin/**/*.js' --test-coverage-include='web/**/*.js' --test-coverage-exclude='tests/**' --test-coverage-exclude='node_modules/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=node-test-junit-reporter --test-reporter-destination=results/TEST-unit.xml --test-reporter=lcov --test-reporter-destination=results/coverage.lcov $(find tests -maxdepth 1 -name '*.test.js' ! -name '*.playwright.test.js' | sort)",
    "test:e2e": "node --test --test-concurrency=1 tests/*.playwright.test.js",
    "test:e2e:ci": "mkdir -p results && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=node-test-junit-reporter --test-reporter-destination=results/TEST-e2e.xml tests/*.playwright.test.js",
    "render:examples": "node bin/gantry.js render kiwi-cover-mutual soap --workspaces-dir workspaces/examples && node bin/gantry.js render kiwi-cover-mutual hld --workspaces-dir workspaces/examples && node bin/gantry.js render kiwi-cover-mutual sad --workspaces-dir workspaces/examples && node bin/gantry.js render kiwi-cover-mutual ssad --workspaces-dir workspaces/examples && node bin/gantry.js render kiwi-cover-mutual as-built --workspaces-dir workspaces/examples && node bin/gantry.js render gantry soap --workspaces-dir workspaces/examples && node bin/gantry.js render gantry soap-full --workspaces-dir workspaces/examples"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@preact/signals": "^2.11.1",
    "codemirror": "^6.0.2",
    "commander": "^13.0.0",
    "dompurify": "^3.4.13",
    "eta": "^4.6.0",
    "htm": "^3.1.1",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.17.2",
    "pandoc-wasm": "1.1.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "node-test-junit-reporter": "^1.0.0",
    "playwright": "^1.62.1"
  }
}
