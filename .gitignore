node_modules/
.node-runtime/
install.log
run.log
results/
ci-results/

# WI #358: the workspaces root replaces the flat instances/ layout — registries and rendered
# output are gitignored the same way, one level deeper (workspaces/<workspace>/<instance>/out/).
# The instances/ patterns are kept for a pre-0.4 flat data directory that hasn't migrated yet.
instances/*/out/
instances/instance-registry.json
instances/workspace-registry.json
instances/number-registry.json
workspaces/*/*/out/
workspaces/instance-registry.json
workspaces/workspace-registry.json
workspaces/number-registry.json

# WI #386: Global Settings' library repos and their on-disk cache — deployment data, never repo
# content, the same as the registries above.
instances/library-repos.json
instances/library-cache/
workspaces/library-repos.json
workspaces/library-cache/

# WI #370: the reserved `default` server workspace is created on demand by `gantry serve` and
# `gantry new` to hold instances created on this machine — a deployment's own data, never repo
# content (the bundled fixtures live in workspaces/examples/). Without this, merely starting the
# server left a clean checkout dirty.
workspaces/default/
