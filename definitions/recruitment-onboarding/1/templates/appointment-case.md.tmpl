<%~ na(it.modules.selection['preferred-candidate']) %>

## Vetting outcome

<%~ na(it.modules.vetting.outcome) %>

# Offer

## Offer terms

<%~ na(it.modules.offer.terms) %>

## Status

<%~ na(it.modules.offer.status) %>
<% if (it.modules.offer.negotiation) { %>
## Negotiation

<%~ it.modules.offer.negotiation %>
<% } %>
# Contract

## Terms

<%~ na(it.modules.contract['terms-summary']) %>

## Signatures

<%~ na(it.modules.contract.signatures) %>

## Start date

<%~ na(it.modules.contract['start-date']) %>

# Payroll

## Details requested

<%~ na(it.modules.payroll['details-requested']) %>

## Validation outcome

<%~ na(it.modules.payroll['validation-outcome']) %>
