# <%~ it.instance.name || it.instance.slug %>: Offer Pack
<%
  /* The outward-facing half of the `onboarding-approved` gate, written for the appointed
     candidate. Carries the same core field set as `appointment-approval` so it cannot become
     the soft path through the gate (see the artefact's comment in definition.yaml), but
     deliberately carries no selection or vetting content — nothing about how other candidates
     were assessed belongs in a document that leaves the organisation. */
%>
# Your role

## Role summary

<%~ na(it.modules.role.summary) %>

## Team and reporting line

<%~ na(it.modules.role.team) %>

## Key responsibilities

<% it.modules.role.responsibilities.forEach(function(item) { %>- <%~ item %>
<% }) %>
## Engagement type

<%~ na(it.modules.engagement.type) %>

# Your offer

## Terms

<%~ na(it.modules.offer.terms) %>

## Status

<%~ na(it.modules.offer.status) %>

# Your contract

## Terms

<%~ na(it.modules.contract['terms-summary']) %>

## Signatures

<%~ na(it.modules.contract.signatures) %>

## Start date

<%~ na(it.modules.contract['start-date']) %>

# Payroll

## Details requested from you

<%~ na(it.modules.payroll['details-requested']) %>

## Validation outcome

<%~ na(it.modules.payroll['validation-outcome']) %>

## Confirmation

<%~ na(it.modules.payroll.confirmed) %>
<% if (it.modules['open-questions'].questions && it.modules['open-questions'].questions.length) { %>
# Open questions

<% it.modules['open-questions'].questions.forEach(function(item) { %>- <%~ item %>
<% }) %><% } %>
