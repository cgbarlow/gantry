<% it.modules.role.responsibilities.forEach(function(item) { %>- <%~ item %>
<% }) %>
## Justification

<%~ na(it.modules.role.justification) %>

# Engagement

## Engagement type

<%~ na(reqType) %>
<% if (reqTerm || (reqType && reqType !== 'Permanent')) { %>
## Term or expected duration

<%~ reqTerm || '— not stated —' %>
<% } %>
## Rationale

<%~ na(it.modules.engagement.rationale) %>

## Standard approval route for this engagement type

<%~ reqRoute %>
<% if (it.modules.engagement['route-variation']) { %>
## Route variation

<%~ it.modules.engagement['route-variation'] %>
<% } %>
# Role evaluation

