# <%~ it.instance.name || it.instance.slug %>: Manager Handover
<%
  /* Written for the hiring manager, who has been a participant since the requisition but has
     not been following the stages. It leads with what they have to do and only then reports
     what is already in place — the reverse of `starter-readiness`, which is the same core
     field set written for the people who did the provisioning.

     v3 (#158): `document-control: false` and `satisfies-gate: false` (spec #147) — this is an
     audience document, and Starter Readiness or the Hire Record still has to carry the gate.
     `requires` is exactly what this prints plus the filename tokens `selection.candidate-name`
     (the manager chose the candidate; not printed) and `contract.start-date`.

     Deliberately not printed, all of it Technology's own record and printed in Starter
     Readiness and the Hire Record instead: the reporting line (the manager wrote it),
     `identity.account`, `identity.propagation`, `identity.credential-issue` (the manager is
     told to send the credentials, not told that they already were), `access.setup`, and open
     questions (any the manager owes are in their own actions instead). The headline is derived
     from what is outstanding; `handover.readiness-confirmation` no longer exists (#157). */
  const inPlace = !it.modules.access.outstanding && it.modules.device['build-status'] === 'Ready'
%>
<%~ inPlace ? 'Everything is in place for the start date.' : 'Some items are not yet in place. See below.' %>

# Your new starter

## Role

<%~ na(it.modules.role.summary) %>

## Start date

<%~ na(formatDate(it.modules.contract['start-date'])) %>

# What you need to do

<% it.modules.handover['manager-actions'].forEach(function(item) { %>- <%~ item %>
<% }) %>
## The first day

<%~ na(it.modules.handover['day-one']) %>

# What is already in place

## User ID

<%~ na(it.modules.identity['user-id']) %>

## Device

<%~ na(it.modules.device.specification) %>

## Device build

<%~ na(it.modules.device['build-status']) %>

## Access

<% it.modules.access.entitlements.forEach(function(item) { %>- <%~ item %>
<% }) %>
<% if (it.modules.access.outstanding) { %>
## Not in place by the start date

<%~ it.modules.access.outstanding %>
<% } %>
