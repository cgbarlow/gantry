# <%~ it.instance.name || it.instance.slug %>: Hire Record
<%
  /* The permanent file: every module in the definition, in the order the process ran, grouped
     by stage so it reads as a chronology. It is the record as at readiness sign-off; anything
     learned after the first day is added by reopening Provisioning.

     Carried-forward entries stay bare in `requires` (unlike every other later document), so
     the kept file is complete whenever it is complete. That also makes it the strictest
     document at ready-to-start: the gate can pass on Starter Readiness alone, and only complete
     documents are rendered into the approval request — hence the stage purpose's "request
     approval only once the Hire Record is complete".

     The only document that prints `contract.elapsed`, `open-questions.process-gaps` and
     `payroll.validation-outcome` (optional since v3). No approval sections: each stage's
     sign-off is its merged pull request.

     v3: derived approval-route line replaces `engagement.approval-route`; two signature dates
     replace `contract.signatures`; `handover.readiness-confirmation` is gone; `identity.user-id`,
     `device.standard`, `device.build-notes`, `engagement.route-variation` and
     `contract.variations` are new. Named from the candidate alone: a moved start date should
     not rename the kept file. */
  const hrType = it.modules.engagement.type
  const hrTerm = it.modules.engagement.term
  const hrRoute = (hrType === 'Fixed term' || hrType === 'Permanent') ? 'Full approval chain'
    : (hrType === 'Vendor' || hrType === 'Contractor') ? 'Shortened approval chain' : '— n/a —'
  const hrQuestions = it.modules['open-questions'].questions || []
  const hrGaps = it.modules['open-questions']['process-gaps']
%>
