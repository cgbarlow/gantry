<% (it.modules.role.responsibilities || []).forEach(function(item) { %>- <%~ item %>
<% }) %>
## Justification

<%~ na(it.modules.role.justification) %>

## Engagement type

<%~ na(hrType) %>
<% if (hrTerm || (hrType && hrType !== 'Permanent')) { %>
