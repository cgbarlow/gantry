# <%~ it.instance.name || it.instance.slug %>: Starter Readiness
<%
  /* Technology's provisioning record. Identity, device and access run in parallel in the source
     model; they are rendered in sequence because a document has one order. Identity first,
     because device and access both depend on the directory record existing.

     v3 (#157): prints who the starter is and which team they join (email groups, shared drives
     and directory placement follow the team). Printing the candidate name overturns the v2
     CHANGELOG's "never as a rendered section" for this document. `handover.manager-actions`
     and `handover.day-one` stay bare in `requires` so this document and the Hire Record hold
     the same same-stage bar, but are not printed: Technology acts on neither, and the Hire
     Record prints both. `open-questions.process-gaps?` is authoring scope only.

     `handover.readiness-confirmation` is gone: readiness is the ready-to-start sign-off itself.
     `access.outstanding` is retitled "Not in place by the start date". Warns when the device
     is not Ready and nothing is listed under "Not in place by the start date". */
  const srStandard = it.modules.device.standard
%>
# The starter

## Starter

<%~ na(it.modules.selection['candidate-name']) %>

## Role

<%~ na(it.modules.role.summary) %>

## Team and reporting line

<%~ na(it.modules.role.team) %>

## Start date

<%~ na(formatDate(it.modules.contract['start-date'])) %>

# Identity

## User ID

<%~ na(it.modules.identity['user-id']) %>

## Account

<%~ na(it.modules.identity.account) %>

## Propagation

<%~ na(it.modules.identity.propagation) %>

## Credential issue

<%~ na(it.modules.identity['credential-issue']) %>

# Device

## Standard or non-standard

<%~ na(srStandard) %>

## Specification

<%~ na(it.modules.device.specification) %>
<% if (it.modules.device['non-standard-decision'] || srStandard === 'Non-standard') { %>
## Non-standard hardware decision

<%~ it.modules.device['non-standard-decision'] || '— not stated —' %>
<% } %>
## Build status

<%~ na(it.modules.device['build-status']) %>
<% if (it.modules.device['build-status'] !== 'Ready' && !it.modules.access.outstanding) { %>
**Warning:** the device is not Ready and is not listed under "Not in place by the start date". This stage should not be signed off.
<% } %>
<% if (it.modules.device['build-notes']) { %>
## Build notes

<%~ it.modules.device['build-notes'] %>
<% } %>
# Access

## Entitlements

<% (it.modules.access.entitlements || []).forEach(function(item) { %>- <%~ item %>
<% }) %>
## Setup

<%~ na(it.modules.access.setup) %>
<% if (it.modules.access.outstanding) { %>
## Not in place by the start date

<%~ it.modules.access.outstanding %>
<% } %>
<% if (it.modules['open-questions'].questions && it.modules['open-questions'].questions.length) { %>
# Open questions

<% it.modules['open-questions'].questions.forEach(function(item) { %>- <%~ item %>
<% }) %><% } %>
