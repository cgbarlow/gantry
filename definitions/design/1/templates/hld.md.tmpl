  const nfrs = it.modules.nfrs || {}
  const nfrParts = [
    nfrs.performance,
    nfrs['availability-and-continuity'],
    nfrs['disaster-recovery-and-backup'],
    nfrs['scalability-and-capacity'],
    nfrs['other-nfrs'],
    nfrs['requirements-traceability'],
  ].filter(Boolean)
%>
<% if (nfrParts.length) { %>
## Non-functional requirements

<%~ nfrParts.join('\n\n') %>
<% } %>

