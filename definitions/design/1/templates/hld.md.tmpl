<%
  const security = it.modules.security || {}
  const regulations = security['regulations-and-standards'] && security['regulations-and-standards'].length
    ? security['regulations-and-standards'].map(function(item) { return '- ' + item }).join('\n')
    : null
  const securityParts = [
    security['identity-and-access'],
    security['security-architecture'],
    regulations,
    security['privacy-and-confidentiality'],
  ].filter(Boolean)
%>
