# <%~ it.instance.slug %>: As-built

<%
  /* Intentional consolidation (WI #269): this template deliberately collapses the
     ATLAS reference deep Data Migration Flows and Migration Services hierarchies
     (~70 headings) into a few generic as-built fields — it is NOT a 1:1 heading map
     to the reference, and that is by design. See
     docs/research/design-definition-reference-reconciliation.md section 4 and section 9,
     grounded in docs/reconciliation/as-built-reconciliation.md (rows P3-P10, section 2.D, W1-W5). */
  const intro = it.modules.introduction || {}
  const glossary = it.modules.glossary || {}
  const notes = it.modules['as-built-notes'] || {}
  const recovery = it.modules['recovery-plan'] || {}
  const dsc = it.modules['data-security-controls'] || {}
  // Cross-cutting blank-field guard (WI #269): render the heading with a literal
  // "— n/a —" line when a required field is blank/absent, rather than an empty
  // section. Non-blank output is byte-identical.
  const na = (v) => (typeof v === 'string' && v.trim() !== '') ? v : '— n/a —'
%>
