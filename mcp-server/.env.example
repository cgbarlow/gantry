# The gantry serve deployment this MCP server is a thin HTTP client of.
GANTRY_BASE_URL=https://gantry.example.com

# Single shared bearer token gating access to this MCP server. Put the same value in your MCP
# client's connection config as `Authorization: Bearer <this value>`.
GANTRY_MCP_ACCESS_TOKEN=change-me

# JSON object mapping workspace id -> Personal Access Token, for every Provider-backed workspace
# (Azure DevOps, GitHub, GitLab, Atlassian) this server needs to act on. A workspace's id is the one
# `list_workspaces` returns. A server-directory workspace needs no entry here.
GANTRY_WORKSPACE_PATS={"<workspace-id>":"<pat>"}

# Port this server listens on (optional, defaults to 3100).
PORT=3100
